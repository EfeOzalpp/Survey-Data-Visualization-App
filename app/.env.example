# Application
JWT_SECRET=replace-with-a-long-random-secret
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=0
CLUSTER_MODE=false
LOAD_TEST_MODE=false
# Explicit local/demo mode. Never use mock data as an automatic production fallback.
VITE_USE_MOCK_DATA=false
RATE_LIMIT_SALT=replace-with-a-long-random-secret
IDEMPOTENCY_SALT=replace-with-a-long-random-secret

# PostgreSQL
# Host development reaches the local PostgreSQL service through 127.0.0.1.
# Compose overrides this URL inside containers and uses the `postgres` service
# hostname instead.
DATABASE_URL=postgresql://butterfly_effect_app:replace-with-app-password@127.0.0.1:5432/butterfly_effect
POSTGRES_PASSWORD=butterfly-effect-local
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000

# Sanity CMS (retained for gamification copy)
SANITY_PROJECT_ID=2dnm6wwp
SANITY_DATASET=butterfly-habits
SANITY_READ=
SANITY_API_VERSION=2022-03-07
